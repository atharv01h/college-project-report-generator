# Environment Variables Template
# Copy this file to .env and fill in your actual keys.
# NEVER commit the .env file — it is in .gitignore.

# Google Gemini API Key
# Get yours at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Unsplash API Access Key (optional — images will be disabled if not set)
# Get yours at: https://unsplash.com/developers
VITE_UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
